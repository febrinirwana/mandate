# Public chain configuration
SEPOLIA_RPC_URL=https://sepolia.example.invalid
SETTLEMENT_FORK_RPC_URL=https://mainnet.example.invalid

# Sepolia Mandate deployment
SEPOLIA_MAX_MANDATE_DURATION=2592000
SEPOLIA_MANDATE_APP=replace_me
SEPOLIA_MANDATE_DEPLOYMENT_BLOCK=11648628
SEPOLIA_VENUE_INPUT_RECIPIENT=replace_me

# Sepolia ENSv2 identity; values are public on-chain identifiers.
SEPOLIA_OWNER_ADDRESS=replace_me
SEPOLIA_AGENT_ADDRESS=replace_me
SEPOLIA_IDENTITY_REGISTRY=replace_me
SEPOLIA_IDENTITY_RESOLVER=replace_me
SEPOLIA_IDENTITY_LABEL=replace_me
SEPOLIA_PARENT_LABEL=replace_me
SEPOLIA_IDENTITY_EXPIRY=replace_me


# Public web runtime (copy these public values to apps/web/.env.local).
MANDATE_CHAIN_ID=11155111
MANDATE_API_ORIGIN=http://127.0.0.1:3001
MANDATE_POLICY_PROFILE=replace_with_verified_single_line_json
MANDATE_SEPOLIA_FAUCET_AMOUNT=100
NEXT_PUBLIC_PRIVY_APP_ID=replace_me
# Server-only integrations
ONEINCH_API_KEY=replace_me
BAZANTIC_API_KEY=replace_me
API_PORT=3001

# Supabase managed PostgreSQL. Runtime uses the transaction pooler; migrations use
# the session pooler because this workstation is IPv4-only.
SUPABASE_PROJECT_REF=jmdcxiukvyfizslwvxgp
SUPABASE_DB_PASSWORD=replace_me
DATABASE_URL=postgresql://postgres.jmdcxiukvyfizslwvxgp:replace_me@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_MIGRATION_URL=postgresql://postgres.jmdcxiukvyfizslwvxgp:replace_me@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Canonical receipt confirmation worker. Inclusion counts as confirmation one.
WORKER_CONFIRMATION_DEPTH=4
WORKER_BATCH_SIZE=25
WORKER_POLL_INTERVAL_MS=15000

# Never place owner or agent private keys in browser-exposed variables.
AGENT_KEYSTORE_PATH=replace_me
AGENT_KEYSTORE_PASSWORD=replace_me
