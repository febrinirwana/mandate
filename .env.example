# Public chain configuration
SEPOLIA_RPC_URL=https://sepolia.example.invalid
SETTLEMENT_FORK_RPC_URL=https://mainnet.example.invalid

# Sepolia Mandate deployment
SEPOLIA_MAX_MANDATE_DURATION=2592000

# Sepolia ENSv2 identity; values are public on-chain identifiers.
SEPOLIA_OWNER_ADDRESS=replace_me
SEPOLIA_AGENT_ADDRESS=replace_me
SEPOLIA_IDENTITY_REGISTRY=replace_me
SEPOLIA_IDENTITY_RESOLVER=replace_me
SEPOLIA_IDENTITY_LABEL=replace_me
SEPOLIA_PARENT_LABEL=replace_me
SEPOLIA_IDENTITY_EXPIRY=replace_me

# Server-only integrations
ONEINCH_API_KEY=replace_me
BAZANTIC_API_KEY=replace_me

# Local PostgreSQL
DATABASE_URL=postgresql://mandate:mandate@localhost:5432/mandate

# Never place owner or agent private keys in browser-exposed variables.
AGENT_KEYSTORE_PATH=replace_me
AGENT_KEYSTORE_PASSWORD=replace_me
